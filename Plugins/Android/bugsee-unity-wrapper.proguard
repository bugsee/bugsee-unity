# Applied to the app's R8 run by Editor/BugseeAndroidProguardRules (appended to unityLibrary/proguard-unity.txt);
# Unity does not read this file from Plugins/Android itself. UnityWrapper and UnityManagedException are looked up by
# name from C# over JNI (AndroidJavaClass / AndroidJavaObject), which R8 cannot trace.
-keep class com.bugsee.unity.UnityWrapper {
    static void refineContext(java.lang.String, java.lang.String, java.lang.String, java.lang.String, java.lang.String);
    static void channelLog(java.lang.String, int, int);
    static void channelAddNetwork(com.bugsee.library.contracts.exchange.NetworkEvent);
    static void setSecureBuffer(int, int[]);
    static void attachLifecycleListener(com.bugsee.library.contracts.lifecycle.LifecycleEventListener);
    static void setManagedDataProvider(com.bugsee.library.contracts.common.DataRequestProvider);
    static void replyNoData(com.bugsee.library.contracts.common.DataRequestResultCallback);
}
# Every method C# calls is public static; keeping them all means a new one cannot be stripped by forgetting to list it.
-keep class com.bugsee.unity.UnityWrapper {
    public static <methods>;
}
-keep class com.bugsee.unity.UnityWrapperProvider { *; }
# C# calls UnityWrapper.testCrash() via JNI. Its anonymous Runnable (UnityWrapper$1) is what appears in the
# crash's stack frame, so keep its name readable instead of relying on the mapping file.
-keep class com.bugsee.unity.UnityWrapper {
    static void testCrash();
}
-keepnames class com.bugsee.unity.UnityWrapper$*
# C# builds this Throwable by name (new AndroidJavaObject("com.bugsee.unity.UnityManagedException", json)); the worker
# routes managed exceptions on its class name, so it must keep both the constructor and its name.
-keep class com.bugsee.unity.UnityManagedException {
    <init>(java.lang.String);
}
# Not reached by name (its constants are inlined at compile time); kept so the identity file survives intact.
-keep class com.bugsee.unity.UnityWrapperIdentity { *; }
# C# implements these SDK interfaces with AndroidJavaProxy, which dispatches by method name. The SDK's own consumer
# rules keep them today; stating it here keeps the wrapper working if those rules narrow.
-keep interface com.bugsee.library.contracts.exchange.EventFilter { *; }
-keep interface com.bugsee.library.contracts.reporting.ReportHandler { *; }
-keep interface com.bugsee.library.contracts.reporting.ReportCreationListener { *; }
-keep interface com.bugsee.library.contracts.lifecycle.LifecycleEventListener { *; }
-keep interface com.bugsee.library.contracts.common.Callback1 { *; }
-keep interface com.bugsee.library.contracts.feedback.FeedbackListener { *; }
# The optional Feedback AAR (see FeedbackOptIn): C# calls the contract's methods and the registration entry point by name.
-keep interface com.bugsee.library.contracts.extensions.Feedback { *; }
-keep class com.bugsee.library.BugseeFeedback {
    public static void registerFeedbackExtension();
}
-keep interface com.bugsee.library.contracts.common.DataRequestProvider { *; }
# C# calls sanitize() on Bugsee.getDefaultNetworkSanitizer() by name (Bugsee.ApplyDefaultNetworkSanitizer).
-keep interface com.bugsee.library.contracts.exchange.NetworkDataSanitizer { *; }
-keep interface com.bugsee.library.contracts.common.DataRequestResultCallback { *; }
# UnityWrapperProvider registers the SDK extensions by reflection (each facade's register method; see
# UnityWrapperProvider.EXTENSIONS). The AARs' own consumer rules keep them; stated here so the registration survives
# if those rules narrow. A rule for a class the app does not carry matches nothing.
-keep class com.bugsee.library.BugseeNdk { public static void registerNdkExtension(); }
-keep class com.bugsee.library.BugseeFeedback { public static void registerFeedbackExtension(); }
-keep class com.bugsee.library.BugseeLeak { public static void registerLeakExtension(); }
-keep class com.bugsee.library.BugseeRemoting { public static void registerRemotingExtension(); }
# The Android SDK (7.4.2) references classes newer than the compile jar: android.telephony.satellite.* (in android.jar only
# from API 36) and android.app.ApplicationStartInfo (API 35). Its own consumer rules have no -dontwarn, and Unity 6's
# proguard template no longer has -ignorewarnings, so a Minify build whose Target API Level selects an older jar stops in
# R8 with "Missing class" (#255). The SDK's satellite capture requires API 36 and catches the class being absent at run
# time; BugseeProcessInfoProvider reads ApplicationStartInfo only when SDK_INT >= 35. Dropping the warnings is safe.
-dontwarn android.telephony.satellite.SatelliteManager
-dontwarn android.telephony.satellite.SatelliteStateChangeListener
-dontwarn android.app.ApplicationStartInfo
