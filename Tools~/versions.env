# Pinned native SDK versions for the Bugsee Unity UPM package.
# Sourced by Tools~/scripts/update-native-sdks.sh

BUGSEE_PACKAGE_VERSION="0.1.0"

# Latest published Android 7.x on Maven Central
ANDROID_SDK_VERSION="7.1.1"
ANDROID_MAVEN_GROUP="com.bugsee"
ANDROID_MAVEN_ARTIFACT="bugsee-android"
ANDROID_FEEDBACK_ARTIFACT="bugsee-android-feedback"
ANDROID_NDK_ARTIFACT="bugsee-android-ndk"
ANDROID_GRADLE_PLUGIN_VERSION="4.0.5"

# iOS: nextgen is not on bugsee/spm yet — build/copy from local ios/sdk checkout
IOS_SDK_SOURCE="local-nextgen"
IOS_SDK_REPO_PATH="${IOS_SDK_REPO_PATH:-$HOME/Projects/Bugsee/ios/sdk}"
IOS_SDK_BRANCH="nextgen"
# Relative to IOS_SDK_REPO_PATH; SPM-oriented nextgen build output
IOS_XCFRAMEWORK_PATH="${IOS_XCFRAMEWORK_PATH:-build/result/xcframeworks/spm/Bugsee.xcframework}"
