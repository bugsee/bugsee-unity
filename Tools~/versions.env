# Pinned native SDK versions for the Bugsee Unity UPM package.
# Sourced by Tools~/scripts/update-native-sdks.sh

BUGSEE_PACKAGE_VERSION="0.1.0"

# Latest published Android 7.x on Maven Central
ANDROID_SDK_VERSION="7.1.4"
ANDROID_MAVEN_GROUP="com.bugsee"
ANDROID_MAVEN_ARTIFACT="bugsee-android"
ANDROID_FEEDBACK_ARTIFACT="bugsee-android-feedback"
ANDROID_NDK_ARTIFACT="bugsee-android-ndk"
ANDROID_GRADLE_PLUGIN_VERSION="4.0.6"

# iOS: GitHub nextgen (not a local ios/sdk checkout)
IOS_SDK_REPO="https://github.com/bugsee/bugsee-cocoa.git"
IOS_SDK_BRANCH="nextgen"
IOS_SDK_COMMIT="fe9ceb89d8a1948c03e2d754019e2a933ad7698a"
# Optional absolute path to a prebuilt SPM xcframework built from that commit
IOS_XCFRAMEWORK_PATH="${IOS_XCFRAMEWORK_PATH:-}"
